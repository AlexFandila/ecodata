# Copia este fichero a .env y rellena los valores.
# El .env real NUNCA entra en git (ver .gitignore y CLAUDE.md).

# --- API (apps/api) ---

# Puerto en el que escucha la API. Solo se enlaza a 127.0.0.1: la exposición al
# móvil va por Tailscale, nunca por una interfaz pública (ADR-003).
PORT=3000

# Ruta de la base SQLite, relativa a apps/api. La de desarrollo vive en .dev/
# (git-ignored) y se puebla con `pnpm seed`, siempre con datos sintéticos.
DB_PATH=.dev/dev.db

# Token estático que la PWA envía en cabecera. Auth mínima suficiente para un
# solo usuario dentro de la tailnet (ARCHITECTURE.md). Genera uno con:
#   node -e "console.log(crypto.randomUUID())"
API_TOKEN=

# Variantes de tu nombre tal como aparecen en los extractos, separadas por
# comas (por ejemplo: NOMBRE APELLIDO,APELLIDO NOMBRE). El matching de
# transferencias internas las usa como señal para desempatar cuando un traspaso
# tiene varios candidatos posibles. Es dato personal y por eso vive aquí y no en
# el repo (ADR-013). Dejarlo vacío es correcto: el matching sigue funcionando,
# solo pierde esa señal.
HOLDER_NAMES=

# --- Web (apps/web) ---

# Base de la API para la PWA. En desarrollo la sirve el proxy de Vite, así que
# el valor por defecto /api ya funciona sin tocar nada.
VITE_API_URL=/api
